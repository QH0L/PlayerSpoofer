function F.attachAccessory(char, accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not (handle and handle:IsA("BasePart")) then
		accessory.Parent = char
		return false
	end
	local oldWeld = handle:FindFirstChild("AccessoryWeld")
	if oldWeld then
		oldWeld:Destroy()
	end
	handle.Anchored = false
	handle.CanCollide = false
	handle.Massless = true
	local weld = Instance.new("Weld")
	weld.Name = "AccessoryWeld"
	local attachment = handle:FindFirstChildOfClass("Attachment")
	local target = attachment and findCharacterAttachment(char, attachment.Name)
	if target and target.Parent and target.Parent:IsA("BasePart") then
		weld.Part0 = target.Parent
		weld.C0 = target.CFrame
		weld.C1 = attachment.CFrame
	else
		local head = char:FindFirstChild("Head")
		if not (head and head:IsA("BasePart")) then
			accessory.Parent = char
			return false
		end
		weld.Part0 = head
		weld.C0 = CFrame.new(0, 0.5, 0)
		weld.C1 = accessory.AttachmentPoint
	end
	weld.Part1 = handle
	weld.Parent = handle
	accessory.Parent = char
	return true
end
local hiddenParts = setmetatable({}, { __mode = "k" })
local function hideInstance(inst)
	if hiddenParts[inst] then
		return
	end
	local st = { game = inst.Transparency, pending = 0 }
	hiddenParts[inst] = st
	if inst.Transparency ~= 1 then
		st.pending = 1
		inst.Transparency = 1
	end
	st.conn = inst:GetPropertyChangedSignal("Transparency"):Connect(function()
		if hiddenParts[inst] ~= st then
			return
		end
		local v = inst.Transparency
		if v == 1 and st.pending > 0 then
			st.pending = st.pending - 1
			return
		end
		st.game = v
		if v ~= 1 then
			st.pending = st.pending + 1
			inst.Transparency = 1
		end
	end)
end
local function unhideInstance(inst)
	local st = hiddenParts[inst]
	if not st then
		return
	end
	hiddenParts[inst] = nil
	if st.conn then
		st.conn:Disconnect()
	end
	if inst.Parent then
		inst.Transparency = st.game
	end
end
local function hideTree(root)
	if root:IsA("BasePart") or root:IsA("Decal") or root:IsA("Texture") then
		hideInstance(root)
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
			hideInstance(d)
