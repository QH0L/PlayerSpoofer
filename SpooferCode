local function waitForHumanoid(player, timeout)
	local deadline = os.clock() + timeout
	repeat
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
				or char:WaitForChild("Humanoid", math.max(0.05, math.min(0.5, deadline - os.clock())))
			if hum then
				return hum, char
			end
		else
			task.wait(0.03)
		end
	until os.clock() > deadline
	return nil, nil
end
local function waitForBody(char, timeout)
	local deadline = os.clock() + timeout
	char:WaitForChild("Head", timeout)
	while os.clock() < deadline do
		if char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") then
			return true
		end
		task.wait(0.03)
	end
	return false
end
