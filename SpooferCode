function F.dressAccessories(char, model, useReplica)
	local slots, attached, approx, skipped, unplaced = {}, 0, 0, 0, 0
	for _, item in ipairs(model:GetChildren()) do
		if item:IsA("Accessory") then
			local handle = item:FindFirstChild("Handle")
			if handle and handle:FindFirstChildWhichIsA("WrapLayer", true) then
				skipped = skipped + 1
			else
				local mount = F.accessoryMount(model, item)
				if mount then
					local template = item:Clone()
					local th = template:FindFirstChild("Handle")
					for _, w in ipairs(th and th:GetChildren() or {}) do
						if w:IsA("JointInstance") or w:IsA("WeldConstraint") or w:IsA("RigidConstraint") then
							w:Destroy()
						end
					end
					local slot = { template = template, mount = mount, useReplica = useReplica }
					local ok, exact = F.weldSlot(char, slot)
					if ok then
						attached = attached + 1
						if not exact then
							approx = approx + 1
						end
					end
					table.insert(slots, slot)
				else
					unplaced = unplaced + 1
				end
			end
		end
	end
