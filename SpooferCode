function F.scanCoreBody(list)
	if not CoreGuiRoot then
		return
	end
	if #list == 0 then
		for label in pairs(friendTexts) do
			pcall(F.restoreFriendText, label)
		end
		for icon in pairs(coreImages) do
			coreImages[icon] = nil
			pcall(restoreImage, icon)
		end
		return
	end
	local wantImages, wantFriend, template = {}, {}, nil
	local scanned = 0
	for _, d in ipairs(CoreGuiRoot:GetDescendants()) do
		scanned = scanned + 1
		if scanned % 300 == 0 then
			task.wait()
		end
		if d.Parent and not isOurs(d) then
			if isTextObject(d) then
				if not handleInspectTitle(d, list) then
					local st = tagWatch[d]
					if not (st and d.Text == st.desired) then
						processTag(d, list)
					end
				end
				local current = friendTexts[d]
				if d.Text == "Add Friend" and not current and not template then
					template = d
				end
				if (isFriendWord(d.Text) or current) and F.fixFriendLabel(d, list) then
					wantFriend[d] = true
				end
			elseif isImageObject(d) then
				if fixImage(d, list) then
					wantImages[d] = true
				end
			end
		end
	end
	if template then
		boxStyle = F.captureBoxStyle(template) or boxStyle
	end
	for label, st in pairs(friendTexts) do
		if wantFriend[label] then
			pcall(F.applyBoxStyle, label, st)
		else
			pcall(F.restoreFriendText, label)
		end
	end
	for icon in pairs(coreImages) do
		if not wantImages[icon] then
			coreImages[icon] = nil
			pcall(restoreImage, icon)
		end
	end
end
