local function groupDigits(n)
	local sign = n < 0 and "-" or ""
	local digits = toStr(math.floor(math.abs(n)))
	repeat
		local replaced, count = digits:gsub("^(%d+)(%d%d%d)", "%1,%2")
		digits = replaced
	until count == 0
	return sign .. digits
end
local function releaseLeaderstat(userId, name, restore)
