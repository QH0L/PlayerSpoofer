function F.applyHeadReplica(char, model)
	local head = char:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return nil, "target has no Head part"
	end
	local source = model:FindFirstChild("Head")
	if not (source and source:IsA("BasePart")) then
		return nil, "their avatar model has no Head part"
	end
	local old = char:FindFirstChild("SpoofHead")
	if old then
		old:Destroy()
	end
	local replica = source:Clone()
	F.stripHeadCopy(replica)
	replica.Name = "SpoofHead"
	replica.Anchored = false
	replica.CanCollide = false
	replica.CanTouch = false
	replica.CanQuery = false
	replica.Massless = true
	replica.Transparency = 0
	local weld = Instance.new("Weld")
	weld.Name = "SpoofHeadWeld"
	weld.Part0 = head
	weld.Part1 = replica
	weld.C0 = CFrame.new(F.targetNeckOffset(char, head))
	weld.C1 = CFrame.new(F.replicaNeckOffset(replica))
	weld.Parent = replica
	replica.CFrame = head.CFrame * weld.C0 * weld.C1:Inverse()
	markSpoof(replica, char)
	replica.Parent = char
	hideTree(head)
	headMirrors[replica] = { source = head, decals = decalBases(replica) }
	watchMirrorSource(head)
	ensureMirrorLoop()
	return replica
end
function F.accessoryMount(model, accessory)
	local handle = accessory:FindFirstChild("Handle")
	if not (handle and handle:IsA("BasePart")) then
		return nil
	end
	for _, w in ipairs(handle:GetChildren()) do
		if w:IsA("Weld") and w.Part0 and w.Part1 then
			if w.Part1 == handle and w.Part0:IsDescendantOf(model) then
				return { part = w.Part0.Name, c0 = w.C0, c1 = w.C1, how = "weld" }
			elseif w.Part0 == handle and w.Part1:IsDescendantOf(model) then
				return { part = w.Part1.Name, c0 = w.C1, c1 = w.C0, how = "weld" }
			end
		elseif w:IsA("WeldConstraint") or w:IsA("RigidConstraint") then
			local other = (w.Part0 == handle) and w.Part1 or w.Part0
			if w:IsA("RigidConstraint") then
				other = nil
			end
			if other and other:IsA("BasePart") and other:IsDescendantOf(model) then
				return { part = other.Name, c0 = other.CFrame:ToObjectSpace(handle.CFrame), c1 = CFrame.new(), how = "constraint" }
			end
		end
	end
	local accAtt = handle:FindFirstChildWhichIsA("Attachment")
	if accAtt then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Attachment") and d.Name == accAtt.Name and d ~= accAtt
				and not d:FindFirstAncestorOfClass("Accessory") and d.Parent:IsA("BasePart") then
				return { part = d.Parent.Name, c0 = d.CFrame, c1 = accAtt.CFrame, how = "attachment" }
			end
		end
	end
	return nil
end
function F.mountPart(char, partName, useReplica)
	if partName == "Head" and useReplica then
		local replica = char:FindFirstChild("SpoofHead")
		if replica then
			return replica, true
		end
	end
	local part = char:FindFirstChild(partName)
	if part and part:IsA("BasePart") then
		return part, true
	end
	local r6 = R15_TO_R6[partName]
	part = r6 and char:FindFirstChild(r6)
	if part and part:IsA("BasePart") then
		return part, false
	end
	return nil, false
end
function F.weldSlot(char, slot)
	local accessory = slot.template:Clone()
	local handle = accessory:FindFirstChild("Handle")
	local part, exact = F.mountPart(char, slot.mount.part, slot.useReplica)
	if not (handle and part) then
		return false, false
	end
	for _, d in ipairs(accessory:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "AccessoryWeld"
	weld.Part0 = part
	weld.Part1 = handle
	weld.C0 = slot.mount.c0
	weld.C1 = slot.mount.c1
	weld.Parent = handle
	handle.CFrame = part.CFrame * weld.C0 * weld.C1:Inverse()
	markSpoof(accessory, char)
	accessory.Parent = char
	slot.live = accessory
	for _, d in ipairs(accessory:GetDescendants()) do
		if d:IsA("BasePart") then
			mirrors[d] = { source = part, base = d.Transparency, decals = decalBases(d) }
		end
	end
	if not headMirrors[part] then
		watchMirrorSource(part)
	end
	mirrorDirty = true
	ensureMirrorLoop()
	return true, exact
end
