	st.conn:Disconnect()
	if restore and st.obj.Parent then
		st.obj.Value = st.real
	end
end
function F.releaseAllLeaderstats(userId, restore)
	for name in pairs(statData[userId] or {}) do
		releaseLeaderstat(userId, name, restore)
	end
	for _, conn in ipairs(statWatchConns[userId] or {}) do
		conn:Disconnect()
	end
