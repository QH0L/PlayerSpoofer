function F.onApply()
	if editor.busy or not editor.targetId then
		return
	end
	local targetId = editor.targetId
	local display = trim(editor.displayBox.Text)
	local username = trim(editor.userBox.Text)
	local rank = editor.selectedRank
	local rankNumber = nil
	do
		local raw = trim(editor.rankNumBox.Text)
		if raw ~= "" then
			if not raw:match("^%d+$") or #raw > 9 then
				F.setStatus("Rank number must be digits only", COLOR_BAD)
				return
			end
			rankNumber = toNum(raw)
		end
	end
	local hideFriend = editor.hideFriend
	local premium = editor.premium
	local device = editor.device
	local stats = {}
	for _, item in ipairs(editor.statBoxes) do
		local raw = item.box.Text
		local text = trim(raw)
		if text ~= "" then
			stats[item.name] = text
		elseif raw ~= "" then
			stats[item.name] = ""
		end
	end
	if next(stats) == nil then
		stats = nil
	end
	if display == "" and username == "" and not rank and rankNumber == nil and not stats and not hideFriend and premium == nil and not device then
		F.resetTarget(targetId)
		F.setStatus("Nothing entered - showing real values", COLOR_MUTED)
		return
	end
	if username ~= "" and not username:match("^[%w_]+$") then
		F.setStatus("Invalid username", COLOR_BAD)
		return
	end
	editor.busy = true
	F.setStatus("Applying...", COLOR_MUTED)
	task.spawn(function()
		local function say(text, color)
			if editor.targetId == targetId then
				F.setStatus(text, color)
			end
		end
		local entry = {
			display = display ~= "" and display or nil,
			rank = rank,
			rankNumber = rankNumber,
			stats = stats,
			hideFriend = hideFriend or nil,
			premium = premium,
			device = device,
		}
		if username ~= "" then
			say("Fetching user...", COLOR_MUTED)
			local ok, userId = pcall(Players.GetUserIdFromNameAsync, Players, username)
			if not ok or luaType(userId) ~= "number" then
				editor.busy = false
				say("User not found", COLOR_BAD)
				return
			end
			local okName, canonical = pcall(Players.GetNameFromUserIdAsync, Players, userId)
			entry.username = (okName and luaType(canonical) == "string") and canonical or username
			entry.image = HEADSHOT_PREFIX .. userId .. HEADSHOT_SUFFIX
			entry.userId = userId
		end
		local previous = spoofs[targetId]
		spoofs[targetId] = entry
		F.listCache = nil
		do
			local statPlayer = Players:GetPlayerByUserId(targetId)
			if statPlayer then
				pcall(applyLeaderstats, statPlayer, entry)
			end
		end
		refresh(targetId)
		local message, color = "Applied", COLOR_GOOD
		local player = Players:GetPlayerByUserId(targetId)
		if player then
			F.watchCharacter(player)
			if previous and previous.userId and not entry.userId then
				F.restoreLook(player)
			end
			if entry.userId then
				say("Applying character...", COLOR_MUTED)
			end
			local okChar, info, tags = F.applyCharacter(player, entry)
			local tagText = (tags or 0) .. " name tag(s) changed"
			if entry.userId then
				if okChar then
					message = "Applied (" .. toStr(info) .. ", " .. tagText .. ")"
				else
					message, color = "UI applied, character failed: " .. toStr(info), COLOR_BAD
					warn(TAG .. "character apply failed: " .. toStr(info))
				end
			else
				message = "Applied (" .. tagText .. ")"
			end
		else
			message = "Applied (player has left - character not changed)"
		end
		if F.syncAlive and spoofs[targetId] == entry then
			pcall(F.syncSend, targetId, entry)
		end
		editor.busy = false
		say(message, color)
	end)
end
