function F.refreshFallback()
	local fb = F.fallback
	if not (fb and fb.gui.Parent) then
		return
	end
	fb.panel.Visible = fb.open
	if not fb.open then
		fb.sig = ""
		return
	end
	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)
	local parts = {}
	for _, p in ipairs(players) do
		local e = spoofs[p.UserId]
		parts[#parts + 1] = p.UserId .. "|" .. ((e and (e.display or e.username)) or p.DisplayName) .. "|" .. ((e and (e.username or e.display)) or p.Name) .. "|" .. ((e and e.image) or "")
	end
	local sig = table.concat(parts, "\n")
	if sig == fb.sig then
		return
	end
	fb.sig = sig
	for _, child in ipairs(fb.listFrame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	fb.listFrame.Size = UDim2.new(1, 0, 0, math.min(#players * 48, 360))
	for i, player in ipairs(players) do
		local entry = spoofs[player.UserId]
		local row = make("TextButton", {
			Name = "Row_" .. player.UserId,
			Size = UDim2.new(1, -6, 0, 44),
			LayoutOrder = i,
			BackgroundColor3 = COLOR_FIELD,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			AutoButtonColor = true,
