	sourceWatch[src] = {
		src:GetPropertyChangedSignal("Transparency"):Connect(mark),
		src:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(mark),
	}
	mirrorDirty = true
end
local mirrorConn = nil
local function ensureMirrorLoop()
	if not mirrorConn then
		mirrorConn = game:GetService("RunService").Heartbeat:Connect(function()
			if mirrorDirty then
