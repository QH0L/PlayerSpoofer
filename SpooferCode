	local tags = F.applyCharName(player, entry)
	return ok, info, tags
end
function F.watchCharacter(player)
	if charConns[player] then
		return
	end
	charConns[player] = player.CharacterAdded:Connect(function(char)
		local uid = player.UserId
		task.spawn(function()
			local entry = spoofs[uid]
			if entry then
				pcall(F.applyCharacter, player, entry)
			end
		end)
	end)
end
function F.resetTarget(targetId, silent)
	local previous = spoofs[targetId]
	spoofs[targetId] = nil
	F.listCache = nil
	if not silent and F.syncAlive then
		pcall(F.syncClear, targetId)
	end
	local player = Players:GetPlayerByUserId(targetId)
	if player then
		pcall(applyLeaderstats, player, nil)
	end
	refresh(targetId)
	if player then
		task.spawn(function()
			if previous and previous.userId then
				F.restoreLook(player)
			end
			F.applyCharName(player, nil)
		end)
	end
end
