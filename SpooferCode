local SKIP_RECOLOR = { [Enum.Material.Neon] = true, [Enum.Material.ForceField] = true, [Enum.Material.Glass] = true }
function F.reskinEffect(container, look, ownerId)
	local sig = realSigs[ownerId]
	local hasFakeAccessories, hasFakeColors = false, false
	for _, d in ipairs(container:GetDescendants()) do
		if d:GetAttribute("SpoofItem") then
			if d:IsA("Accoutrement") then
				hasFakeAccessories = true
			elseif d:IsA("BodyColors") then
				hasFakeColors = true
			end
		elseif d:IsA("Accoutrement") then
			hideTree(d)
		elseif d.Parent == container and (d:IsA("Clothing") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") or d:IsA("CharacterMesh")) then
			d:Destroy()
		elseif sig and d:IsA("BasePart") and not isFakePart(d) and not d.Parent:IsA("Accoutrement") then
			local key = meshKeyOfPart(d)
			if key and sig.meshes[key] then
				hideTree(d)
			end
		end
	end
	if not hasFakeColors then
		F.copyClothes(container, look.model)
	end
	for _, part in ipairs(container:GetDescendants()) do
		if part:IsA("BasePart") and not isFakePart(part) and not SKIP_RECOLOR[part.Material] then
			local src = look.model:FindFirstChild(part.Name)
			if src and src:IsA("BasePart") and part.Parent == container then
				part.Color = src.Color
			end
		end
	end
	local head = container:FindFirstChild("Head")
	local srcHead = look.model:FindFirstChild("Head")
	if look.r6 and head and head:IsA("BasePart") and srcHead then
		for _, d in ipairs(head:GetChildren()) do
			if HEAD_LOOK_CLASSES[d.ClassName] and not d:GetAttribute("SpoofItem") then
				d:Destroy()
			end
		end
		for _, d in ipairs(srcHead:GetChildren()) do
			if HEAD_LOOK_CLASSES[d.ClassName] then
				local copy = d:Clone()
				if copy:IsA("Decal") or copy:IsA("Texture") then
					copy.Transparency = math.max(copy.Transparency, head.Transparency)
				end
				copy:SetAttribute("SpoofItem", true)
				copy.Parent = head
			end
		end
	end
	if not hasFakeAccessories then
		for _, slot in ipairs(look.slots) do
			pcall(F.weldSlot, container, { template = slot.template, mount = slot.mount, useReplica = false })
		end
	end
	pcall(followTransparency, container)
end
