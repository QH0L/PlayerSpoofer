function F.outfitMatch(container, sig)
	local score, contradiction = 0, false
	for _, d in ipairs(container:GetDescendants()) do
		if not isFakePart(d) then
			if d.Parent == container and d:IsA("Shirt") then
				if sig.shirt and sig.shirt ~= "" and d.ShirtTemplate == sig.shirt then
					score = score + 2
				else
					contradiction = true
				end
			elseif d.Parent == container and d:IsA("Pants") then
				if sig.pants and sig.pants ~= "" and d.PantsTemplate == sig.pants then
					score = score + 2
				else
					contradiction = true
				end
			elseif d.Parent == container and d:IsA("BodyColors") then
				if sig.torso and d.TorsoColor3 == sig.torso then
					score = score + 1
				end
			elseif d:IsA("Accoutrement") then
				local key = accessoryKey(d)
				if (key and sig.meshes[key]) or sig.acc[d.Name] then
					score = score + 1
				else
					contradiction = true
				end
			elseif d:IsA("BasePart") and not d.Parent:IsA("Accoutrement") then
				local key = meshKeyOfPart(d)
				if key and sig.meshes[key] then
					score = score + 1
				end
			end
		end
	end
	return score, contradiction
end
