local function plainReplace(haystack, needle, replacement)
	if needle == "" then
		return haystack, false
	end
	local i, j = string.find(haystack, needle, 1, true)
	if not i then
		return haystack, false
	end
	return haystack:sub(1, i - 1) .. replacement .. haystack:sub(j + 1), true
end
local function spoofTagText(base, player, displayNew, userNew, rich)
	if rich then
		displayNew = displayNew and escapeRich(displayNew)
		userNew = userNew and escapeRich(userNew)
	end
	if #base < 2 or not (string.find(base, player.Name, 1, true) or string.find(base, player.DisplayName, 1, true)) then
		return nil
	end
	local candidates = {}
	if userNew then
		table.insert(candidates, { "@" .. player.Name, "@" .. userNew })
	end
	if player.DisplayName == player.Name then
		local only = displayNew or userNew
		if only then
			table.insert(candidates, { player.Name, only })
		end
	else
		if displayNew then
			table.insert(candidates, { player.DisplayName, displayNew })
		end
		if userNew then
			table.insert(candidates, { player.Name, userNew })
		end
	end
	table.sort(candidates, function(a, b)
		return #a[1] > #b[1]
	end)
	for _, pair in ipairs(candidates) do
		local text, hit = plainReplace(base, pair[1], pair[2])
		if hit then
			return text
		end
	end
	return nil
end
local function spoofedPlayers()
