function F.hookHead(dd, header, player)
	local avatar = header:FindFirstChild("AvatarImage", true)
	if not (avatar and avatar:IsA("GuiObject")) then
		warn(TAG .. "AvatarImage not found in the dropdown header - cannot hook the head click")
		return
	end
	local lastOpen = 0
	local function open()
		local now = os.clock()
		if now - lastOpen < 0.2 then
			return
		end
		lastOpen = now
		F.openEditor(player)
	end
	avatar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			open()
		end
	end)
	local conn
	conn = track(UserInputService.InputBegan:Connect(function(input)
		if not dd.Parent then
			conn:Disconnect()
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local m = UserInputService:GetMouseLocation()
		local p, s = avatar.AbsolutePosition, avatar.AbsoluteSize
		if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y then
			open()
		end
	end))
	dd.Destroying:Connect(function()
		conn:Disconnect()
	end)
end
function F.onDropdownAdded(dd)
	local inner = dd:FindFirstChild("InnerFrame", true)
	local header = inner and inner:FindFirstChild("PlayerHeader", true)
	local handleLabel = header and findLabel(header, "PlayerName")
	local name = handleLabel and handleLabel.Text:match("^@(.+)$")
	local player = name and Players:FindFirstChild(name)
	if not (inner and header and player and player:IsA("Player")) then
		warn(TAG .. "could not identify the player for this dropdown")
		return
	end
	live = { frame = dd, header = header, inner = inner, player = player }
