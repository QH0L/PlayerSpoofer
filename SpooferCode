local function updateNameplates()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	for userId, gui in pairs(nameplates) do
		local label = gui:FindFirstChild("NameText")
		local head = gui.Adornee
		if label and head and head.Parent then
			local dist = (cam.CFrame.Position - head.Position).Magnitude
			local scale = dist < 20 and 1 or (dist < 50 and 0.75 or 0.5)
			label.TextSize = math.floor(18 * scale + 0.5)
			local maxDist = 100
			local player = Players:GetPlayerByUserId(userId)
			local hum = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.NameDisplayDistance > 0 then
				maxDist = hum.NameDisplayDistance
			end
			local fade = dist < maxDist * 0.9 and 0 or math.clamp((dist - maxDist * 0.9) / (maxDist * 0.1), 0, 1)
			label.TextTransparency = fade
			label.TextStrokeTransparency = 0.45 + 0.55 * fade
		end
	end
