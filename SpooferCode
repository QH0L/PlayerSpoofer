		return
	end
	local container
	if inst:IsA("Accoutrement") or inst:IsA("Clothing") or inst:IsA("BodyColors") then
		if inst:GetAttribute("SpoofItem") and not inst:GetAttribute("SpoofOwner") then
			return
		end
		container = inst.Parent
		if not (container and container:IsA("Model")) then
			return
		end
	elseif inst:IsA("MeshPart") or inst:IsA("SpecialMesh") then
		local part = inst:IsA("SpecialMesh") and inst.Parent or inst
		local key = part and part:IsA("BasePart") and meshKeyOfPart(part)
		if not key then
			return
		end
		local known = false
		for _, sig in pairs(realSigs) do
			if sig.meshes[key] then
				known = true
				break
			end
		end
		if not known then
			return
		end
		container = effectContainer(inst)
		if not container then
			return
		end
	else
		return
	end
	if skinnedEffects[container] or Players:GetPlayerFromCharacter(container) then
		return
	end
	skinnedEffects[container] = true
	task.defer(function()
		if not container.Parent then
			return
		end
		local okRun, ownerId, why = pcall(effectOwner, container)
		if not okRun then
			skinnedEffects[container] = nil
			print(TAG .. "effect check failed: " .. toStr(ownerId))
			return
		end
		local look = ownerId and fakeLooks[ownerId]
		if look then
			pcall(F.reskinEffect, container, look, ownerId)
			pcall(F.watchEffect, container)
			if effectLogged < 4 then
				effectLogged = effectLogged + 1
				print(TAG .. "effect model re-skinned: " .. container:GetFullName())
			end
		else
			skinnedEffects[container] = nil
			if why and rejectedLogged < 3 and not rejectedEffects[container] then
				rejectedEffects[container] = true
				rejectedLogged = rejectedLogged + 1
				print(TAG .. "effect model left alone: " .. why)
			end
		end
	end)
end
