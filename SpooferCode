local function shadowLabel(label, text, rich)
	local sh = shadows[label]
	if not (sh and sh.Parent) then
		sh = label:Clone()
		sh.Name = "SpoofShadow"
		sh.Parent = label.Parent
		shadows[label] = sh
	end
	sh.RichText = rich == true
	sh.Text = text
	sh.Visible = true
	label.Visible = false
	return sh
end
local function restoreLabel(label)
