end
local function applyMirror(part, t, ltm, decals)
	if part.Transparency ~= t then
		part.Transparency = t
	end
	part.LocalTransparencyModifier = ltm
	for d, base in pairs(decals) do
		if d.Parent then
			local dt = math.max(base, t)
			if d.Transparency ~= dt then
				d.Transparency = dt
			end
		end
	end
end
local function updateMirrors()
	for part, m in pairs(headMirrors) do
		if part.Parent and m.source.Parent then
			applyMirror(part, effectiveTransparency(m.source), m.source.LocalTransparencyModifier, m.decals)
		else
			headMirrors[part] = nil
		end
	end
	for part, m in pairs(mirrors) do
		if part.Parent and m.source.Parent then
			local src = m.source
			local t = headMirrors[src] and src.Transparency or effectiveTransparency(src)
			applyMirror(part, math.max(m.base, t), src.LocalTransparencyModifier, m.decals)
		else
			mirrors[part] = nil
		end
	end
end
