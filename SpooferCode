		editor.gui:Destroy()
	end)
end
pcall(function()
	TextChatService.OnIncomingMessage = nil
end)
local INSPECT_METHODS = { InspectPlayerFromUserId = true, InspectPlayerFromUserIdWithCtx = true }
local inspectState = ENV[INSPECT_KEY]
if not inspectState then
	inspectState = { installed = {} }
	local function mapUserId(userId)
		local resolve = inspectState.resolve
		if resolve then
			local okR, mapped = pcall(resolve, userId)
			if okR and luaType(mapped) == "number" then
				return mapped
			end
		end
		return userId
	end
	if luaType(hookfunction) == "function" then
		for methodName in pairs(INSPECT_METHODS) do
			local original
			local wrapper = function(self, userId, ...)
				if robloxType(self) == "Instance" and self == GuiService then
					userId = mapUserId(userId)
				end
				return original(self, userId, ...)
			end
			local okH, err = pcall(function()
				local target = GuiService[methodName]
				original = hookfunction(target, luaType(newcclosure) == "function" and newcclosure(wrapper) or wrapper)
			end)
			if okH and original then
				table.insert(inspectState.installed, "hookfunction:" .. methodName)
			else
				warn(TAG .. "hookfunction on " .. methodName .. " failed: " .. toStr(err))
			end
		end
	end
	if luaType(hookmetamethod) == "function" and luaType(getnamecallmethod) == "function" then
		local oldNamecall
		local okN, errN = pcall(function()
			local hook = function(self, ...)
				local method = getnamecallmethod()
				if INSPECT_METHODS[method] and self == GuiService then
					local args = table.pack(...)
					args[1] = mapUserId(args[1])
					return oldNamecall(self, table.unpack(args, 1, args.n))
				end
				return oldNamecall(self, ...)
			end
			oldNamecall = hookmetamethod(game, "__namecall", luaType(newcclosure) == "function" and newcclosure(hook) or hook)
		end)
		if okN and oldNamecall then
			table.insert(inspectState.installed, "__namecall")
		else
			warn(TAG .. "__namecall hook failed: " .. toStr(errN))
		end
	end
	ENV[INSPECT_KEY] = inspectState
end
if #inspectState.installed == 0 then
	warn(TAG .. "no Inspect hook could be installed - the title watcher will re-open Examine Avatar for the fake user instead")
else
	print(TAG .. "Inspect redirect active via: " .. table.concat(inspectState.installed, ", "))
end
inspectState.resolve = function(userId)
	local entry = spoofs[userId]
	return entry and entry.userId or nil
end
