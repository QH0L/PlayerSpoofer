function F.collectStats(player)
	local out = {}
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return out
	end
	for _, child in ipairs(leaderstats:GetChildren()) do
		if child:IsA("ValueBase") then
			local st = statData[player.UserId] and statData[player.UserId][child.Name]
			table.insert(out, {
				name = child.Name,
				value = toStr(st and st.real or child.Value),
				order = toNum(child:GetAttribute("LeaderboardOrder")) or math.huge,
			})
		end
	end
	table.sort(out, function(a, b)
		if a.order == b.order then
			return a.name < b.name
		end
		return a.order < b.order
	end)
	return out
end
function F.rebuildStats(player, entry)
	for _, item in ipairs(editor.statBoxes) do
		item.row:Destroy()
	end
	table.clear(editor.statBoxes)
	local stats = F.collectStats(player)
	editor.statsLabel.Visible = #stats > 0
	for i, stat in ipairs(stats) do
