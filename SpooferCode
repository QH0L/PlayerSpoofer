end
function F.keepAlive(player, char, entry, slots, model)
	local readds = 0
	local deadline = os.clock() + 40
	while os.clock() < deadline and readds < 40 do
		task.wait(0.5)
		if spoofs[player.UserId] ~= entry or player.Character ~= char or not char.Parent then
			return
		end
		local head = char:FindFirstChild("Head")
		if model and head and head:IsA("BasePart") then
			local replica = char:FindFirstChild("SpoofHead")
			local weld = replica and replica:FindFirstChild("SpoofHeadWeld")
			if not (replica and weld and weld.Part0 == head) then
				pcall(F.applyHeadReplica, char, model)
				readds = readds + 1
			end
		end
		for _, slot in ipairs(slots) do
			if not (slot.live and slot.live.Parent == char) then
				pcall(F.weldSlot, char, slot)
				readds = readds + 1
			end
		end
	end
end
