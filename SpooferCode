end
local applyLeaderstats
function F.waitForLeaderstats(player, entry)
	local userId = player.UserId
	if statWatchConns[userId] then
		return
	end
	local function retry()
		task.defer(function()
			if spoofs[userId] == entry and player.Parent then
				pcall(applyLeaderstats, player, entry)
			end
		end)
	end
	statWatchConns[userId] = {
		player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" then
				child.ChildAdded:Connect(retry)
				retry()
			end
		end),
	}
	local folder = player:FindFirstChild("leaderstats")
	if folder then
		table.insert(statWatchConns[userId], folder.ChildAdded:Connect(retry))
	end
end
function applyLeaderstats(player, entry)
	local userId = player.UserId
	local folder = player:FindFirstChild("leaderstats")
	local wanted = {}
	if entry and entry.stats then
		if folder then
			for name, text in pairs(entry.stats) do
				local number = parseCount(text)
				local obj = number and folder:FindFirstChild(name)
				if obj and (obj:IsA("IntValue") or obj:IsA("NumberValue")) then
					wanted[name] = number
				end
			end
		end
		F.waitForLeaderstats(player, entry)
	end
	for name in pairs(statData[userId] or {}) do
		if wanted[name] == nil then
			releaseLeaderstat(userId, name, true)
		end
	end
	if not entry then
		F.releaseAllLeaderstats(userId, true)
		return
	end
	for name, number in pairs(wanted) do
		local obj = folder[name]
		local st = statData[userId] and statData[userId][name]
		if st and st.obj == obj then
			st.fake = number
			if obj.Value ~= number then
				st.expect = number
				obj.Value = number
			end
		else
			if st then
				releaseLeaderstat(userId, name, true)
			end
			st = { obj = obj, real = obj.Value, fake = number }
			statData[userId] = statData[userId] or {}
			statData[userId][name] = st
			st.conn = obj:GetPropertyChangedSignal("Value"):Connect(function()
				local value = obj.Value
				if st.expect ~= nil then
					local expected = st.expect
					st.expect = nil
					if value == expected then
						return
					end
				end
				if value == st.fake then
					return
				end
				local delta = value - st.real
				st.real = value
				if delta > 0 then
					st.fake = st.fake + delta
					local current = spoofs[userId]
					if current and current.stats then
						current.stats[name] = math.abs(st.fake) >= 1000 and groupDigits(st.fake) or toStr(st.fake)
					end
				end
				st.expect = st.fake
				obj.Value = st.fake
			end)
			if obj.Value ~= number then
				st.expect = number
				obj.Value = number
			end
		end
	end
end
local statTrackers = setmetatable({}, { __mode = "k" })
local function untrackStat(label)
	local st = statTrackers[label]
	if st then
		st.conn:Disconnect()
		statTrackers[label] = nil
	end
end
local function trackStat(label, userId, name)
	local st = statTrackers[label]
	if st and st.userId == userId and st.name == name then
		return
	end
	untrackStat(label)
	st = { userId = userId, name = name, last = parseCount(label.Text) }
	statTrackers[label] = st
	st.conn = label:GetPropertyChangedSignal("Text"):Connect(function()
		local now = parseCount(label.Text)
		local before = st.last
		st.last = now
		if not (now and before and now > before) then
			return
		end
		local entry = spoofs[userId]
		local current = entry and entry.stats and entry.stats[name]
		local base = current and parseCount(current)
		if not base then
			return
		end
		local updated = base + (now - before)
		local text = math.abs(updated) >= 1000 and groupDigits(updated) or toStr(updated)
		entry.stats[name] = text
		local sh = shadows[label]
		if sh and sh.Parent then
			sh.Text = text
		end
	end)
end
function F.applyStats(row, userId)
	local overlay = row:FindFirstChild("OverlayFrame", true)
	if not overlay then
		return
	end
	local entry = spoofs[userId]
	for _, cell in ipairs(overlay:GetChildren()) do
		if cell.Name:sub(1, #STAT_PREFIX) == STAT_PREFIX then
			local label = statLabelOf(cell)
			if label then
				local statName = cell.Name:sub(#STAT_PREFIX + 1)
				local text = entry and entry.stats and entry.stats[statName]
				if statData[userId] and statData[userId][statName] then
					text = nil
				end
				if text then
					shadowLabel(label, text)
					trackStat(label, userId, statName)
				else
					restoreLabel(label)
					untrackStat(label)
				end
			end
		end
	end
end
