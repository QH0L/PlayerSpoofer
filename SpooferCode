local function processTag(label, list)
	local st = tagWatch[label]
	local base = st and st.base or label.Text
	local replacement = applyAllNames(base, list, label.RichText)
	if replacement == base then
		if st then
			unwatchTag(label)
		end
		return false
	end
	if st and st.conn then
		st.conn:Disconnect()
	end
	if st and label.Text ~= st.desired then
		base = label.Text
		replacement = applyAllNames(base, list, label.RichText)
		if replacement == base then
			tagWatch[label] = nil
			return false
		end
	end
	st = { base = base, desired = replacement }
	tagWatch[label] = st
	label.Text = replacement
	st.conn = label:GetPropertyChangedSignal("Text"):Connect(function()
		if label.Text == st.desired or tagWatch[label] ~= st then
			return
		end
		local fresh = applyAllNames(label.Text, spoofedPlayers(), label.RichText)
		if fresh ~= label.Text then
			st.base = label.Text
			st.desired = fresh
			label.Text = fresh
		end
	end)
	return true
end
