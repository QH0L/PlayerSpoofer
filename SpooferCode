local BOX_PROPS = { "BackgroundTransparency", "BackgroundColor3", "BorderSizePixel", "Size", "AutomaticSize" }
local TEXT_PROPS = { "TextColor3", "TextTransparency", "TextSize", "FontFace" }
function F.captureBoxStyle(template)
	local node, depth = template, 0
	while node and node ~= CoreGuiRoot and depth <= 6 do
		if node:IsA("GuiObject") and node:FindFirstChildOfClass("UIStroke") then
			local style = { depth = depth, props = {}, text = {} }
			for _, name in ipairs(BOX_PROPS) do
				style.props[name] = node[name]
			end
			for _, name in ipairs(TEXT_PROPS) do
				style.text[name] = template[name]
			end
			style.stroke = node:FindFirstChildOfClass("UIStroke"):Clone()
			local corner = node:FindFirstChildOfClass("UICorner")
			style.corner = corner and corner:Clone() or nil
			style.path = node:GetFullName()
			return style
		end
		if node ~= template and F.countFriendWords(node) > 1 then
			break
		end
		node, depth = node.Parent, depth + 1
	end
	return nil
end
function F.applyBoxStyle(label, st)
	if st.boxed or not boxStyle then
		return
	end
	local box = label
	for _ = 1, boxStyle.depth do
		box = box and box.Parent
	end
	if not (box and box:IsA("GuiObject")) or box == CoreGuiRoot then
		return
	end
	st.boxed = { box = box, props = {}, text = {}, added = {} }
	for _, name in ipairs(BOX_PROPS) do
		st.boxed.props[name] = box[name]
		pcall(function()
			box[name] = boxStyle.props[name]
		end)
	end
	for _, name in ipairs(TEXT_PROPS) do
		st.boxed.text[name] = label[name]
		pcall(function()
			label[name] = boxStyle.text[name]
		end)
	end
	if not box:FindFirstChildOfClass("UIStroke") then
		local stroke = boxStyle.stroke:Clone()
		stroke.Parent = box
		table.insert(st.boxed.added, stroke)
	end
	if boxStyle.corner and not box:FindFirstChildOfClass("UICorner") then
		local corner = boxStyle.corner:Clone()
		corner.Parent = box
		table.insert(st.boxed.added, corner)
	end
	print(TAG .. "friend box applied: styled " .. box:GetFullName() .. " from template " .. toStr(boxStyle.path))
end
function F.restoreFriendText(label)
	local st = friendTexts[label]
	if not st then
		return
	end
	friendTexts[label] = nil
	if st.conn then
		st.conn:Disconnect()
	end
	if st.boxed then
		local box = st.boxed.box
		for _, inst in ipairs(st.boxed.added) do
			pcall(function()
				inst:Destroy()
			end)
		end
		if box and box.Parent then
			for name, value in pairs(st.boxed.props) do
				pcall(function()
					box[name] = value
				end)
			end
		end
		for name, value in pairs(st.boxed.text) do
			pcall(function()
				label[name] = value
			end)
		end
	end
	if label.Parent and label.Text == st.desired then
