local function overrideImage(icon, image)
	local st = imageOverrides[icon]
	if not st then
		st = { original = icon.Image }
		imageOverrides[icon] = st
		st.conn = icon:GetPropertyChangedSignal("Image"):Connect(function()
			if st.desired and icon.Image ~= st.desired then
				st.original = icon.Image
				icon.Image = st.desired
			end
		end)
	end
	st.desired = image
	icon.Image = image
end
local function restoreImage(icon)
	local st = imageOverrides[icon]
	if st then
		st.desired = nil
		if st.conn then
			st.conn:Disconnect()
		end
		imageOverrides[icon] = nil
		icon.Image = st.original
	end
end
