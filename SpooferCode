function F.applyDropdown(info)
	if not (info and info.frame.Parent) then
		return
	end
	local entry = spoofs[info.player.UserId]
	local header = info.header
	local displayLabel = findLabel(header, "DisplayName")
	if displayLabel then
		local text = nameOverrideText(info.player, entry)
		if text then
			shadowLabel(displayLabel, text, true)
		else
			restoreLabel(displayLabel)
		end
	end
	local handleLabel = findLabel(header, "PlayerName")
	if handleLabel then
		handleLabel.Text = "@" .. ((entry and entry.username) or info.player.Name)
	end
	local avatar = header:FindFirstChild("AvatarImage", true)
	if isImageObject(avatar) then
		avatar.Image = (entry and entry.image) or (HEADSHOT_PREFIX .. info.player.UserId .. HEADSHOT_SUFFIX)
	end
	local friendButton = info.inner and info.inner:FindFirstChild("FriendButton")
	if friendButton then
		local textLabel = friendButton:FindFirstChild("Text", true)
		if not isTextObject(textLabel) then
			textLabel = friendButton:FindFirstChildWhichIsA("TextLabel", true)
		end
		local iconLabel = friendButton:FindFirstChild("Icon", true)
		if entry and entry.hideFriend and isTextObject(textLabel) and not dropdownTextWatch[textLabel] then
			dropdownTextWatch[textLabel] = textLabel:GetPropertyChangedSignal("Text"):Connect(function()
				task.defer(F.applyDropdown, info)
			end)
		end
		if entry and entry.hideFriend and isTextObject(textLabel) and textLabel.Text == "Unfriend" then
			shadowLabel(textLabel, "Friend request")
			if isTextObject(iconLabel) then
				shadowLabel(iconLabel, "person-plus")
			end
		else
			if isTextObject(textLabel) then
				restoreLabel(textLabel)
			end
			if isTextObject(iconLabel) then
				restoreLabel(iconLabel)
			end
		end
	end
	local infoFrame = info.inner and info.inner:FindFirstChild("Info")
	if infoFrame then
		local option = entry and entry.rank and RANKS[entry.rank]
		local rankImage = infoFrame:FindFirstChild("rank", true)
		if isImageObject(rankImage) then
			if option then
				overrideImage(rankImage, option.image)
			else
				restoreImage(rankImage)
			end
		end
		local deviceOption = entry and entry.device and DEVICES[entry.device]
		local deviceIcon = infoFrame:FindFirstChild("DeviceIcon", true)
		if isImageObject(deviceIcon) then
			if deviceOption then
				overrideImage(deviceIcon, deviceOption.image)
			else
				restoreImage(deviceIcon)
			end
		end
		local rankText = infoFrame:FindFirstChild("realrank", true)
		if isTextObject(rankText) and (option or (entry and entry.rankNumber ~= nil)) then
			do
				local number = entry.rankNumber
				if number == nil then
					local real = rankText.Text:match("·%s*(%-?%d+)")
					number = real and toNum(real) or nil
				end
				local name = option and option.text or rankText.Text:match("^(.-)%s*·") or rankText.Text
				local shown = name
				if number ~= nil then
					shown = name .. " · " .. toStr(number)
				end
				local sh = shadowLabel(rankText, shown)
				local gradient = sh:FindFirstChildOfClass("UIGradient")
				if gradient and option and option.colors then
					gradient.Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, option.colors[1]),
						ColorSequenceKeypoint.new(1, option.colors[2]),
					})
				end
			end
		elseif isTextObject(rankText) then
			restoreLabel(rankText)
		end
	end
end
