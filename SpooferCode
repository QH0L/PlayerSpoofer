	end
	local list = F.listCache
	if isTextObject(d) then
		if handleInspectTitle(d, list) then
			return
		end
		local st = tagWatch[d]
		if not (st and d.Text == st.desired) then
			processTag(d, list)
		end
		if isFriendWord(d.Text) then
			pcall(F.fixFriendLabel, d, list) -- same frame, so the real "Friend" never renders
