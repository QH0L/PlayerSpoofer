end
local function unwatchTag(label)
	local st = tagWatch[label]
	if not st then
		return
	end
	tagWatch[label] = nil
	if st.conn then
		st.conn:Disconnect()
	end
	if label.Parent and label.Text == st.desired then
		label.Text = st.base
	end
