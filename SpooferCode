local function retagAll(includeWorkspace)
	local list = spoofedPlayers()
	local changed, paths = 0, {}
	for label in pairs(tagWatch) do
		if not label.Parent or isOurs(label) then
			pcall(unwatchTag, label)
		end
	end
	local function visit(container, needWorldTag)
		local n = 0
		for _, d in ipairs(container:GetDescendants()) do
			n = n + 1
			if n % 200 == 0 then
				task.wait()
			end
			if isTextObject(d) and not isOurs(d) and (not needWorldTag or isWorldTag(d, list)) then
				if processTag(d, list) then
					changed = changed + 1
					if #paths < 6 then
						table.insert(paths, d:GetFullName())
					end
				end
			end
		end
	end
	if #list == 0 then
		for label in pairs(tagWatch) do
			pcall(unwatchTag, label)
		end
		pcall(F.syncFriendIcons, list)
		pcall(F.scanCore, list)
		return 0, paths
	end
	visit(PlayerGui, false)
	-- labels tagged earlier (Tab list, Esc menu, billboards) get the NEW names now, not on the next Esc
	for label in pairs(tagWatch) do
		if label.Parent and not isOurs(label) then
			processTag(label, list)
		end
	end
	local coreList = CoreGuiRoot and CoreGuiRoot:FindFirstChild("PlayerList")
	if coreList then
		visit(coreList, false)
	end
	pcall(F.syncFriendIcons, list)
	for _, item in ipairs(list) do
		local char = item.player.Character
		if char then
			visit(char, true)
		end
	end
	if includeWorkspace then
		visit(workspace, true)
	end
	if CoreGuiRoot and menuOpen() then
		pcall(F.scanCore, list)
	end
	for label in pairs(tagWatch) do
		if label.Parent and applyAllNames(tagWatch[label].base, list, label.RichText) == tagWatch[label].base then
			pcall(unwatchTag, label)
		end
	end
	return changed, paths
end
