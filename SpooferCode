function F.takeSnapshot(char)
	if snapshots[char] then
		return
	end
	local snap = { items = {}, seen = {}, sig = { acc = {}, meshes = {} }, loaded = false }
	local owner = Players:GetPlayerFromCharacter(char)
	if owner then
		local okL, loaded = pcall(owner.HasAppearanceLoaded, owner)
		snap.loaded = okL and loaded == true
	end
	for _, child in ipairs(char:GetDescendants()) do
		if child:IsA("Accoutrement") then
			snap.sig.acc[child.Name] = true
			local key = accessoryKey(child)
			if key then
				snap.sig.meshes[key] = true
			end
		elseif child.Parent == char and isAppearanceItem(child) and not child:GetAttribute("SpoofItem") then
			snap.seen[child] = true
			if child:IsA("Shirt") then
				snap.sig.shirt = child.ShirtTemplate
			elseif child:IsA("Pants") then
				snap.sig.pants = child.PantsTemplate
			elseif child:IsA("BodyColors") then
				snap.sig.torso = child.TorsoColor3
			end
			local okC, copy = pcall(child.Clone, child)
			if okC and copy then
				table.insert(snap.items, copy)
			end
		end
	end
	local head = char:FindFirstChild("Head")
	local face = head and head:FindFirstChildOfClass("Decal")
	if face then
		snap.face = face.Texture
	end
	snap.colors = {}
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			snap.colors[part] = part.Color
		end
	end
	if head and head:IsA("BasePart") then
		snap.headKids = {}
		for _, d in ipairs(head:GetChildren()) do
			if HEAD_LOOK_CLASSES[d.ClassName] then
				local okC, copy = pcall(d.Clone, d)
				if okC and copy then
					table.insert(snap.headKids, copy)
				end
			end
		end
		snap.head = { transparency = head.Transparency, decals = {} }
		for _, d in ipairs(head:GetChildren()) do
			if d:IsA("Decal") or d:IsA("Texture") then
				table.insert(snap.head.decals, { decal = d, transparency = d.Transparency })
