		local head = make("ImageButton", {
			Name = "Head",
			Size = UDim2.fromOffset(36, 36),
			Position = UDim2.fromOffset(6, 4),
			BackgroundColor3 = Color3.fromRGB(60, 60, 66),
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Image = (entry and entry.image) or (HEADSHOT_PREFIX .. player.UserId .. HEADSHOT_SUFFIX),
		}, row)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, head)
		make("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(50, 4),
			Size = UDim2.new(1, -56, 0, 20),
			Font = fb.font,
			TextSize = 14,
			TextColor3 = COLOR_TEXT,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = (entry and (entry.display or entry.username)) or player.DisplayName,
		}, row)
		make("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(50, 24),
			Size = UDim2.new(1, -56, 0, 16),
			Font = fb.font,
			TextSize = 12,
			TextColor3 = COLOR_MUTED,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = "@" .. ((entry and (entry.username or entry.display)) or player.Name),
		}, row)
		local function open()
			local ok, err = pcall(F.openEditor, player)
			if not ok then
				warn(TAG .. "could not open the editor: " .. toStr(err))
			end
		end
		head.Activated:Connect(open)
		row.Activated:Connect(open)
	end
end

