-- ======================================================================
-- SYNC: animation-speed side channel (all state lives in F, no new top-level locals)
-- Every client running this script publishes its own spoofs by playing
-- rbxassetid://316642563 on its own character and changing the track Speed;
-- every other client reads that track's Speed and decodes the spoofs.
-- Frame: START(-2), then 20-bit symbols whose speeds alternate between the
-- [1,2) and [2,3) ranges (speed = 1 or 2, plus n / 2^20), no END marker.
-- Symbols: [header = length*1024 + check][payload bits...][checksum]
-- ======================================================================
F.SYNC = {
	ANIM_ID = "rbxassetid://316642563",
	ANIM_DIGITS = "316642563",
	VERSION = 2,
	SYMBOL_BITS = 20,
	SYMBOL_RANGE = 1048576, -- 2^20
	CHECK_MODULUS = 1048573,
	SYMBOL_INTERVAL = 0.1, -- seconds per symbol step (all lanes step together). 0.4 was measured in Studio; 0.05 is NOT measured. Lower is faster but may lose symbols
	LANES = 1, -- parallel tracks. 1 = single track (the path that worked). Try 2..4 only after 1 works; replication of several tracks is NOT verified
	MAX_LANES = 8, -- receivers accept up to this many lanes per message
	WARMUP = 0.25, -- wait after creating fresh tracks so remote clients can see them before the first symbol
	REPEATS = 1, -- copies of a fresh Apply sent back to back; the LOOP re-sends anyway, so 1 gets the next change out sooner
	LOOP = true, -- keep re-sending every local spoof in a loop when nothing new is queued (a late or missed receiver catches the next START)
	REANNOUNCE_REPEATS = 1,
	TRACK_IDLE_SECONDS = 30, -- keep the tracks alive this long after the last symbol (always while a local spoof exists) so the next send starts at once
	WEIGHT = 0.01, -- track weight; whether this hides the pose on other clients is untested
	REANNOUNCE_SECONDS = 120,
	JOIN_REANNOUNCE_DELAY = 6,
	PREFETCH_TIMEOUT = 12,
	SPEED_IDLE = -1,
	SPEED_START = -2,
	MAX_STRING = 32,
	MAX_STATS = 8,
	MAX_PAYLOAD = 400,
	ALLOWED_SENDERS = nil, -- optional set { [userId] = true }; nil accepts every sender
}
F.syncAlive = true
F.syncMsgs = {}
F.syncLanes = {}
F.syncMid = math.random(0, 255)
F.syncLoopFrame = false
F.syncLoopLast = nil
F.syncWarmUntil = 0
F.syncAsm = setmetatable({}, { __mode = "k" })
F.syncLocal = {}
F.syncSeen = {}
F.syncGen = {}
F.syncRx = setmetatable({}, { __mode = "k" })
F.syncTracks = {}
F.syncAnimator = nil
F.syncLastSend = 0
F.syncLogCount = 0
F.syncErrCount = 0

-- ---------- pure codec (no Roblox APIs) ----------
function F.syncSymbolToSpeed(n, parity)
	return (parity == 0 and 1 or 2) + n / F.SYNC.SYMBOL_RANGE
end

function F.syncSpeedToSymbol(speed)
	local S = F.SYNC
	if type(speed) ~= "number" or speed ~= speed then
		return nil
	end
	if math.abs(speed - S.SPEED_IDLE) < 1e-3 then
		return "idle"
	end
	if math.abs(speed - S.SPEED_START) < 1e-3 then
		return "start"
	end
	local parity, base
	if speed >= 1 and speed < 2 then
		parity, base = 0, 1
	elseif speed >= 2 and speed < 3 then
		parity, base = 1, 2
	else
		return nil
	end
	local n = math.floor((speed - base) * S.SYMBOL_RANGE + 0.5)
	if n < 0 or n >= S.SYMBOL_RANGE then
		return nil
	end
	return "data", n, parity
end

function F.syncChecksum(symbols, count)
	local M = F.SYNC.CHECK_MODULUS
	local c = 0
	for i = 1, count do
		c = (c + (symbols[i] + i) * (i + 7)) % M
	end
	return c
end

function F.syncEncodeHeader(len)
	return len * 1024 + ((len * 37 + 11) % 1024)
end

function F.syncDecodeHeader(h)
	local len = math.floor(h / 1024)
	if len < 1 or len > F.SYNC.MAX_PAYLOAD then
		return nil
	end
	if h % 1024 ~= (len * 37 + 11) % 1024 then
		return nil
	end
	return len
end

function F.syncPackSymbols(bytes)
	local B = F.SYNC.SYMBOL_BITS
	local out, acc, bits = {}, 0, 0
	for i = 1, #bytes do
		acc = acc * 256 + bytes[i]
		bits = bits + 8
		while bits >= B do
			local shift = 2 ^ (bits - B)
			local sym = math.floor(acc / shift)
			acc = acc - sym * shift
			bits = bits - B
			out[#out + 1] = sym
		end
	end
	if bits > 0 then
		out[#out + 1] = acc * 2 ^ (B - bits)
	end
	return out
end

function F.syncUnpackSymbols(symbols, from, to, byteCount)
	local B = F.SYNC.SYMBOL_BITS
	local R = F.SYNC.SYMBOL_RANGE
	local bytes, acc, bits = {}, 0, 0
	for i = from, to do
		acc = acc * R + symbols[i]
		bits = bits + B
		while bits >= 8 and #bytes < byteCount do
			local shift = 2 ^ (bits - 8)
			local b = math.floor(acc / shift)
			acc = acc - b * shift
			bits = bits - 8
			bytes[#bytes + 1] = b
		end
	end
	return bytes
end

function F.syncBuildFrame(bytes, repeats)
	local syms = { F.syncEncodeHeader(#bytes) }
	for _, s in ipairs(F.syncPackSymbols(bytes)) do
		syms[#syms + 1] = s
	end
	syms[#syms + 1] = F.syncChecksum(syms, #syms)
	local speeds = {}
	for _ = 1, repeats or 1 do
		speeds[#speeds + 1] = F.SYNC.SPEED_START
		for i, s in ipairs(syms) do
			speeds[#speeds + 1] = F.syncSymbolToSpeed(s, (i - 1) % 2)
		end
	end
	return speeds
end

function F.syncParseSymbols(symbols)
	local count = #symbols
	if count < 3 then
		return nil, "too short"
	end
	local len = F.syncDecodeHeader(symbols[1])
	if not len then
		return nil, "bad header"
	end
	local payloadSymbols = math.ceil(len * 8 / F.SYNC.SYMBOL_BITS)
	if count ~= payloadSymbols + 2 then
		return nil, "size mismatch"
	end
	if F.syncChecksum(symbols, count - 1) ~= symbols[count] then
		return nil, "checksum"
	end
	local bytes = F.syncUnpackSymbols(symbols, 2, count - 1, len)
	if #bytes ~= len then
		return nil, "unpack"
	end
	return bytes
end

function F.wByte(w, v)
	w.bytes[#w.bytes + 1] = math.floor(v) % 256
end

function F.wVarint(w, v)
	v = math.floor(v)
	repeat
		local b = v % 128
		v = math.floor(v / 128)
		if v > 0 then
			b = b + 128
		end
		w.bytes[#w.bytes + 1] = b
	until v == 0
end

function F.syncClipUtf8(s, maxBytes)
	if #s <= maxBytes then
		return s
	end
	local cut = maxBytes
	while cut > 0 do
		local b = s:byte(cut + 1)
		if b and b >= 128 and b < 192 then
			cut = cut - 1
		else
			break
		end
	end
	return s:sub(1, cut)
end

function F.wString(w, s)
	s = F.syncClipUtf8(toStr(s), F.SYNC.MAX_STRING)
	F.wByte(w, #s)
	for i = 1, #s do
		F.wByte(w, s:byte(i))
	end
end

function F.rByte(r)
	local b = r.bytes[r.pos]
	if b == nil then
		error("payload truncated")
	end
	r.pos = r.pos + 1
	return b
end

function F.rVarint(r)
	local v, mult = 0, 1
	for _ = 1, 7 do
		local b = F.rByte(r)
		v = v + (b % 128) * mult
		if b < 128 then
			return v
		end
		mult = mult * 128
	end
	error("varint too long")
end

function F.rString(r)
	local len = F.rByte(r)
	if len > F.SYNC.MAX_STRING then
		error("string too long")
	end
	local chars = {}
	for i = 1, len do
		chars[i] = string.char(F.rByte(r))
	end
	local s = table.concat(chars)
	if utf8 and utf8.len(s) == nil then
		error("invalid utf8")
	end
	return s
end

function F.syncHasBit(v, mask)
	return math.floor(v / mask) % 2 == 1
end

-- layout: [version*16+op][target varint] then for "set":
-- [flags: 1 display, 2 userId, 4 rank, 8 rankNumber, 16 hideFriend, 32 premiumSet, 64 premiumValue, 128 ext]
-- [ext (only if flags&128): 1 device, 2 stats] [display] [userId] [rank] [rankNumber] [device] [stats]
function F.syncEncodeSet(targetId, entry)
	local S = F.SYNC
	local w = { bytes = {} }
	F.wByte(w, S.VERSION * 16 + 1)
	F.wVarint(w, targetId)
	local rankIndex, deviceIndex
	if entry.rank then
		for i, option in ipairs(RANK_OPTIONS) do
			if option.key == entry.rank then
				rankIndex = i
			end
		end
	end
	if entry.device then
		for i, option in ipairs(DEVICE_OPTIONS) do
			if option.key == entry.device then
				deviceIndex = i
			end
		end
	end
	local statNames = {}
	if entry.stats then
		for name in pairs(entry.stats) do
			statNames[#statNames + 1] = name
		end
		table.sort(statNames)
	end
	if #statNames > S.MAX_STATS then
		error("too many stats")
	end
	local lo, ext = 0, 0
	if entry.display then lo = lo + 1 end
	if entry.userId then lo = lo + 2 end
	if rankIndex then lo = lo + 4 end
	if entry.rankNumber ~= nil then lo = lo + 8 end
	if entry.hideFriend then lo = lo + 16 end
	if entry.premium ~= nil then lo = lo + 32 end
	if entry.premium == true then lo = lo + 64 end
	if deviceIndex then ext = ext + 1 end
	if #statNames > 0 then ext = ext + 2 end
	if ext > 0 then lo = lo + 128 end
	F.wByte(w, lo)
	if ext > 0 then
		F.wByte(w, ext)
	end
	if entry.display then
		F.wString(w, entry.display)
	end
	if entry.userId then
		F.wVarint(w, entry.userId)
	end
	if rankIndex then
		F.wByte(w, rankIndex)
	end
	if entry.rankNumber ~= nil then
		F.wVarint(w, entry.rankNumber)
	end
	if deviceIndex then
		F.wByte(w, deviceIndex)
	end
	if #statNames > 0 then
		F.wByte(w, #statNames)
		for _, name in ipairs(statNames) do
			F.wString(w, name)
			F.wString(w, entry.stats[name])
		end
	end
	if #w.bytes > S.MAX_PAYLOAD then
		error("payload too large")
	end
	return w.bytes
end

function F.syncEncodeClear(targetId)
	local w = { bytes = {} }
	F.wByte(w, F.SYNC.VERSION * 16 + 2)
	F.wVarint(w, targetId)
	return w.bytes
end

-- returns "set", targetId, entry | "clear", targetId | nil, reason
function F.syncDecode(bytes)
	local S = F.SYNC
	local r = { bytes = bytes, pos = 1 }
	local b0 = F.rByte(r)
	if math.floor(b0 / 16) ~= S.VERSION then
		return nil, "version"
	end
	local op = b0 % 16
	local targetId = F.rVarint(r)
	if targetId < 1 then
		error("bad target")
	end
	if op == 2 then
		return "clear", targetId
	end
	if op ~= 1 then
		return nil, "op"
	end
	local lo = F.rByte(r)
	local ext = 0
	if F.syncHasBit(lo, 128) then
		ext = F.rByte(r)
	end
	local entry = {}
	if F.syncHasBit(lo, 1) then
		entry.display = F.rString(r)
	end
	if F.syncHasBit(lo, 2) then
		entry.userId = F.rVarint(r)
		if entry.userId < 1 then
			error("bad fake user id")
		end
	end
	if F.syncHasBit(lo, 4) then
		local option = RANK_OPTIONS[F.rByte(r)]
		if not option then
			error("bad rank index")
		end
		entry.rank = option.key
	end
	if F.syncHasBit(lo, 8) then
		entry.rankNumber = F.rVarint(r)
	end
	if F.syncHasBit(lo, 16) then
		entry.hideFriend = true
	end
	if F.syncHasBit(lo, 32) then
		entry.premium = F.syncHasBit(lo, 64)
	end
	if F.syncHasBit(ext, 1) then
		local option = DEVICE_OPTIONS[F.rByte(r)]
		if not option then
			error("bad device index")
		end
		entry.device = option.key
	end
	if F.syncHasBit(ext, 2) then
		local count = F.rByte(r)
		if count < 1 or count > S.MAX_STATS then
			error("bad stat count")
		end
		entry.stats = {}
		for _ = 1, count do
			local name = F.rString(r)
			entry.stats[name] = F.rString(r)
		end
	end
	return "set", targetId, entry
end

-- ---------- receiver state machine (pure given a fake sender) ----------
function F.syncFeed(sender, rx, speed)
	local kind, n, parity = F.syncSpeedToSymbol(speed)
	if kind == "start" then
		rx.state = "data"
		rx.symbols = {}
		rx.nextParity = 0
		rx.expected = nil
		return
	end
	if rx.state ~= "data" then
		return
	end
	if kind ~= "data" or parity ~= rx.nextParity then
		rx.state = "idle"
		return
	end
	rx.nextParity = 1 - parity
	local symbols = rx.symbols
	symbols[#symbols + 1] = n
	if #symbols == 1 then
		local len = F.syncDecodeHeader(n)
		if not len then
			rx.state = "idle"
			return
		end
		rx.expected = 2 + math.ceil(len * 8 / F.SYNC.SYMBOL_BITS)
	end
	if rx.expected and #symbols >= rx.expected then
		rx.state = "idle"
		rx.symbols = {}
		F.syncFinish(sender, symbols)
	end
end

function F.syncLogLine(text)
	if F.syncLogCount < 80 then
		F.syncLogCount = F.syncLogCount + 1
		print(TAG .. "sync: " .. text)
	end
end

function F.syncFinish(sender, symbols)
	local S = F.SYNC
	if S.ALLOWED_SENDERS and not S.ALLOWED_SENDERS[sender.UserId] then
		return
	end
	local bytes, why = F.syncParseSymbols(symbols)
	if not bytes then
		F.syncLogLine("dropped frame from " .. sender.Name .. " (" .. toStr(why) .. ")")
		return
	end
	F.syncLaneIn(sender, bytes)
end

-- lane chunk = [messageId][lane*16 + laneCount][data...]; all lanes of one message share the id
function F.syncLaneIn(sender, chunk)
	if #chunk < 3 then
		F.syncLogLine("short lane chunk from " .. sender.Name)
		return
	end
	local mid = chunk[1]
	local lane = math.floor(chunk[2] / 16)
	local count = chunk[2] % 16
	if count < 1 or count > F.SYNC.MAX_LANES or lane >= count then
		F.syncLogLine("bad lane header from " .. sender.Name)
		return
	end
	local asm = F.syncAsm[sender]
	if not asm then
		asm = { mid = -1, count = 0, chunks = {}, have = 0, done = false }
		F.syncAsm[sender] = asm
	end
	if asm.mid ~= mid or asm.count ~= count then
		asm.mid, asm.count, asm.chunks, asm.have, asm.done = mid, count, {}, 0, false
	end
	if asm.done or asm.chunks[lane] then
		return
	end
	local data = {}
	for i = 3, #chunk do
		data[#data + 1] = chunk[i]
	end
	asm.chunks[lane] = data
	asm.have = asm.have + 1
	if asm.have < count then
		return
	end
	asm.done = true
	local full = {}
	for l = 0, count - 1 do
		for _, b in ipairs(asm.chunks[l]) do
			full[#full + 1] = b
		end
	end
	F.syncDeliver(sender, full)
end

function F.syncDeliver(sender, bytes)
	local okDecode, op, targetId, entry = pcall(F.syncDecode, bytes)
	if not okDecode then
		F.syncLogLine("bad message from " .. sender.Name .. ": " .. toStr(op))
		return
	end
	if op == nil then
		F.syncLogLine("ignored message from " .. sender.Name .. " (" .. toStr(targetId) .. ")")
		return
	end
	local chars = {}
	for i, b in ipairs(bytes) do
		chars[i] = string.char(b)
	end
	local key = table.concat(chars)
	if op == "clear" then
		if spoofs[targetId] and spoofs[targetId].remote then
			F.syncLogLine("received clear for " .. toStr(targetId) .. " from " .. sender.Name)
		end
		F.syncApplyClear(targetId)
	else
		F.syncApplySet(sender, targetId, entry, key)
	end
end

-- ---------- applying received spoofs ----------
function F.syncCommit(targetId, entry)
	local previous = spoofs[targetId]
	spoofs[targetId] = entry
	F.listCache = nil
	local player = Players:GetPlayerByUserId(targetId)
	if player then
		pcall(applyLeaderstats, player, entry)
	end
	refresh(targetId)
	if player then
		F.watchCharacter(player)
		if previous and previous.userId and not entry.userId then
			pcall(F.restoreLook, player)
		end
		local ok, err = pcall(F.applyCharacter, player, entry)
		if not ok then
			warn(TAG .. "sync: applying received spoof failed: " .. toStr(err))
		end
	end
	-- report what could actually be shown on this client, then re-apply once rows have settled
	local wanted, matched = 0, 0
	for _ in pairs(entry.stats or {}) do
		wanted = wanted + 1
	end
	for _ in pairs(statData[targetId] or {}) do
		matched = matched + 1
	end
	local row = root and root:FindFirstChild("PlayerEntry_" .. targetId, true)
	F.syncLogLine(("applied for %s: player=%s row=%s leaderstats=%s stats %d/%d via leaderstats"):format(
		toStr(targetId),
		toStr(player ~= nil),
		toStr(row ~= nil),
		toStr(player ~= nil and player:FindFirstChild("leaderstats") ~= nil),
		matched,
		wanted
	))
	for _, delay in ipairs({ 0.4, 1.5 }) do
		task.delay(delay, function()
			if F.syncAlive and spoofs[targetId] == entry then
				pcall(refresh, targetId)
			end
		end)
	end
end

function F.syncApplySet(sender, targetId, entry, key)
	local existing = spoofs[targetId]
	if existing and not existing.remote then
		if F.syncSeen[targetId] ~= key then
			F.syncSeen[targetId] = key
			F.syncLogLine("ignored remote spoof for " .. toStr(targetId) .. " from " .. sender.Name .. ": you have a local edit on that player (press Reset on it to accept theirs)")
		end
		return
	end
	if F.syncSeen[targetId] == key then
		return
	end
	F.syncSeen[targetId] = key
	F.syncLogLine("received set for " .. toStr(targetId) .. " from " .. sender.Name)
	entry.remote = true
	entry.from = sender.UserId
	F.syncGen[targetId] = (F.syncGen[targetId] or 0) + 1
	local gen = F.syncGen[targetId]
	task.spawn(function()
		local pending = 0
		if entry.userId then
			pending = 1
			-- resolve the name now; the avatar download runs alongside and does not hold the UI back
			task.spawn(function()
				local okName, canonical = pcall(Players.GetNameFromUserIdAsync, Players, entry.userId)
				if okName and luaType(canonical) == "string" then
					entry.username = canonical
					entry.image = HEADSHOT_PREFIX .. entry.userId .. HEADSHOT_SUFFIX
				else
					entry.userId = nil
				end
				pending = pending - 1
			end)
			task.spawn(function()
				local target = Players:GetPlayerByUserId(targetId)
				local char = target and target.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and hum.RigType == Enum.HumanoidRigType.R6 then
					pcall(F.getR6Avatar, entry.userId)
				else
					pcall(F.getAvatarModel, entry.userId)
				end
			end)
			local deadline = os.clock() + math.min(F.SYNC.PREFETCH_TIMEOUT, 5)
			while pending > 0 and os.clock() < deadline do
				task.wait()
			end
			if not entry.username then
				entry.userId = nil
				entry.image = nil
				F.syncLogLine("could not resolve the fake user id, look skipped")
			end
		end
		if not F.syncAlive or F.syncGen[targetId] ~= gen then
			return
		end
		local current = spoofs[targetId]
		if current and not current.remote then
			return
		end
		F.syncCommit(targetId, entry)
	end)
end

function F.syncApplyClear(targetId)
	F.syncSeen[targetId] = nil
	F.syncGen[targetId] = (F.syncGen[targetId] or 0) + 1
	local existing = spoofs[targetId]
	if existing and existing.remote then
		F.resetTarget(targetId, true)
	end
end

-- ---------- sender ----------
function F.syncEnqueue(targetId, bytes, repeats)
	if F.syncLoopFrame then
		-- a fresh Apply/clear beats a looping re-send: drop the rest of it, receivers resync on the next START
		F.syncLanes = {}
		F.syncLoopFrame = false
	end
	local msgs = F.syncMsgs
	for i = #msgs, 1, -1 do
		if msgs[i].target == targetId then
			table.remove(msgs, i)
		end
	end
	msgs[#msgs + 1] = { target = targetId, bytes = bytes, repeats = repeats or 1 }
end

function F.syncSend(targetId, entry)
	local ok, bytes = pcall(F.syncEncodeSet, targetId, entry)
	if not ok then
		warn(TAG .. "sync: cannot encode spoof for " .. toStr(targetId) .. ": " .. toStr(bytes))
		return
	end
	F.syncLocal[targetId] = entry -- live entry: the loop re-encodes it so later changes (kills counting up) reach everyone
	F.syncLogLine("sending spoof for " .. toStr(targetId) .. " (" .. #bytes .. " bytes)")
	F.syncEnqueue(targetId, bytes, F.SYNC.REPEATS)
end

function F.syncClear(targetId)
	F.syncLocal[targetId] = nil
	F.syncEnqueue(targetId, F.syncEncodeClear(targetId), F.SYNC.REPEATS)
end

function F.syncReannounce()
	if F.SYNC.LOOP then
		return -- the loop already re-sends every local spoof
	end
	for targetId, entry in pairs(F.syncLocal) do
		local ok, bytes = pcall(F.syncEncodeSet, targetId, entry)
		if ok then
			F.syncEnqueue(targetId, bytes, F.SYNC.REANNOUNCE_REPEATS)
		end
	end
end

-- round robin over our own spoofs, in ascending target id order
function F.syncNextLoopTarget()
	local keys = {}
	for targetId in pairs(F.syncLocal) do
		keys[#keys + 1] = targetId
	end
	if #keys == 0 then
		return nil
	end
	table.sort(keys)
	local last = F.syncLoopLast
	for _, targetId in ipairs(keys) do
		if last == nil or targetId > last then
			F.syncLoopLast = targetId
			return targetId
		end
	end
	F.syncLoopLast = keys[1]
	return keys[1]
end

function F.syncPlanLanes(len)
	local S = F.SYNC
	local best, bestCost = 1, nil
	for n = 1, math.max(1, math.min(S.LANES, S.MAX_LANES, 15, len)) do
		local chunk = math.ceil(len / n)
		local cost = 3 + math.ceil((chunk + 2) * 8 / S.SYMBOL_BITS)
		if bestCost == nil or cost < bestCost then
			best, bestCost = n, cost
		end
	end
	return best
end

-- returns one speed list per lane; every lane is a normal frame whose payload is a chunk
function F.syncBuildLanes(bytes, repeats, mid)
	local n = F.syncPlanLanes(#bytes)
	local per = math.ceil(#bytes / n)
	local lanes = {}
	for lane = 0, n - 1 do
		local chunk = { mid, lane * 16 + n }
		for i = lane * per + 1, math.min((lane + 1) * per, #bytes) do
			chunk[#chunk + 1] = bytes[i]
		end
		lanes[#lanes + 1] = F.syncBuildFrame(chunk, repeats)
	end
	return lanes
end

function F.syncStopTrack()
	local tracks = F.syncTracks
	F.syncTracks = {}
	F.syncAnimator = nil
	for _, st in ipairs(tracks) do
		pcall(function() st.track:Stop(0) end)
		pcall(function() st.track:Destroy() end)
		pcall(function() st.anim:Destroy() end)
	end
end

-- makes sure at least `count` tracks are playing; returns ok, createdAny
function F.syncEnsureTracks(count)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		if F.syncErrCount < 3 then
			F.syncErrCount = F.syncErrCount + 1
			warn(TAG .. "sync: cannot send, no Humanoid/Animator on your character yet")
		end
		return false, false
	end
	if F.syncAnimator ~= animator then
		F.syncStopTrack()
		F.syncAnimator = animator
	end
	local created = false
	for i = 1, count do
		local st = F.syncTracks[i]
		if not (st and st.track.IsPlaying) then
			if st then
				pcall(function() st.track:Destroy() end)
				pcall(function() st.anim:Destroy() end)
			end
			local anim = Instance.new("Animation")
			anim.AnimationId = F.SYNC.ANIM_ID
			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if not ok or not track then
				anim:Destroy()
				if F.syncErrCount < 3 then
					F.syncErrCount = F.syncErrCount + 1
					warn(TAG .. "sync: LoadAnimation failed: " .. toStr(track))
				end
				return false, created
			end
			track.Looped = true
			track.Priority = Enum.AnimationPriority.Core
			track:Play(0, F.SYNC.WEIGHT, F.SYNC.SPEED_IDLE)
			F.syncTracks[i] = { track = track, anim = anim }
			created = true
		end
	end
	return true, created
end

function F.syncLanesBusy()
	for _, speeds in ipairs(F.syncLanes) do
		if #speeds > 0 then
			return true
		end
	end
	return false
end

function F.syncTick()
	if not F.syncLanesBusy() then
		local msg = table.remove(F.syncMsgs, 1)
		F.syncLoopFrame = false
		if not msg and F.SYNC.LOOP then
			for _ = 1, 8 do
				local targetId = F.syncNextLoopTarget()
				if not targetId then
					break
				end
				local entry = F.syncLocal[targetId]
				local ok, bytes = false, nil
				if entry and spoofs[targetId] == entry then
					ok, bytes = pcall(F.syncEncodeSet, targetId, entry)
				end
				if ok then
					msg = { bytes = bytes, repeats = 1 }
					F.syncLoopFrame = true
					break
				end
				F.syncLocal[targetId] = nil -- replaced or reset locally, stop looping it
			end
		end
		if msg then
			F.syncMid = (F.syncMid + 1) % 256
			F.syncLanes = F.syncBuildLanes(msg.bytes, msg.repeats, F.syncMid)
		end
	end
	if not F.syncLanesBusy() then
		if #F.syncTracks > 0 and next(F.syncLocal) == nil and os.clock() - F.syncLastSend > F.SYNC.TRACK_IDLE_SECONDS then
			F.syncStopTrack()
		end
		return
	end
	local ok, created = F.syncEnsureTracks(#F.syncLanes)
	if not ok then
		return
	end
	if created then
		F.syncWarmUntil = os.clock() + F.SYNC.WARMUP
	end
	if os.clock() < F.syncWarmUntil then
		return
	end
	for i, speeds in ipairs(F.syncLanes) do
		local speed = table.remove(speeds, 1)
		if speed then
			F.syncTracks[i].track:AdjustSpeed(speed)
		end
	end
	F.syncLastSend = os.clock()
end

-- ---------- reader ----------
function F.syncPoll()
	local sync = F.SYNC
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			local perTrack = F.syncRx[p]
			if animator then
				local seen = 0
				for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
					local a = t.Animation
					if a and string.find(a.AnimationId, sync.ANIM_DIGITS, 1, true) then
						seen = seen + 1
						if not perTrack then
							perTrack = setmetatable({}, { __mode = "k" })
							F.syncRx[p] = perTrack
						end
						local rx = perTrack[t]
						if not rx then
							rx = { state = "idle", symbols = {}, nextParity = 0 }
							perTrack[t] = rx
						end
						local speed = t.Speed
						if speed ~= rx.last then
							rx.last = speed
							F.syncFeed(p, rx, speed)
						end
					end
				end
				if perTrack and seen > (perTrack.maxSeen or 0) then
					perTrack.maxSeen = seen
					if seen > 1 then
						F.syncLogLine(p.Name .. " exposes " .. seen .. " sync tracks")
					end
				end
			end
		end
	end
end

function F.syncStop()
	F.syncAlive = false
	F.syncStopTrack()
end

function F.syncStart()
	local RunService = game:GetService("RunService")
	local acc = 0
	track(RunService.Heartbeat:Connect(function(dt)
		if not F.syncAlive then
			return
		end
		acc = acc + dt
		local step = F.SYNC.SYMBOL_INTERVAL
		if acc < step then
			return
		end
		acc = acc - step
		if acc > step then
			acc = 0
		end
		local ok, err = pcall(F.syncTick)
		if not ok and F.syncErrCount < 5 then
			F.syncErrCount = F.syncErrCount + 1
			warn(TAG .. "sync send error: " .. toStr(err))
		end
	end))
	track(RunService.Heartbeat:Connect(function()
		local ok, err = pcall(F.syncPoll)
		if not ok and F.syncErrCount < 5 then
			F.syncErrCount = F.syncErrCount + 1
			warn(TAG .. "sync poll error: " .. toStr(err))
		end
	end))
	track(Players.PlayerAdded:Connect(function()
		task.delay(F.SYNC.JOIN_REANNOUNCE_DELAY, function()
			if F.syncAlive then
				F.syncReannounce()
			end
		end)
	end))
	task.spawn(function()
		while F.syncAlive do
			task.wait(F.SYNC.REANNOUNCE_SECONDS)
			if F.syncAlive then
				F.syncReannounce()
			end
		end
	end)
	print(TAG .. "sync channel active (animation " .. F.SYNC.ANIM_ID .. ", " .. F.SYNC.SYMBOL_INTERVAL .. "s per symbol, " .. F.SYNC.SYMBOL_BITS .. " bits per symbol, up to " .. F.SYNC.LANES .. " lanes)")
end
