local function effectOwner(container)
	for _, d in ipairs(container:GetDescendants()) do
		local owner = d:GetAttribute("SpoofOwner")
		if owner and spoofs[owner] and fakeLooks[owner] then
			return owner
		end
	end
	local bestId, bestScore, why = nil, 0, nil
	for userId, sig in pairs(realSigs) do
		local entry = spoofs[userId]
		local player = entry and fakeLooks[userId] and Players:GetPlayerByUserId(userId)
		if player then
			local score, contradiction = F.outfitMatch(container, sig)
			if score >= 1 then
				local named = F.namedAfter(container, player, entry) or string.find(container.Name:lower(), "clone", 1, true) ~= nil
				if contradiction then
					why = why or (container:GetFullName() .. " has an item " .. player.Name .. " does not wear")
				elseif named or (score >= 2 and F.nearPlayer(container, player)) then
					score = score + (named and 100 or 0)
					if score > bestScore then
						bestId, bestScore = userId, score
					end
				else
					why = why or (container:GetFullName() .. " matches " .. player.Name .. " but is unnamed and score " .. score .. " or too far")
				end
			end
		end
	end
	return bestId, why
